{
  "policy_version": "1.2",
  "lanes": {
    "SONNET_MEDIUM": {"agent": "implement-small",   "model": "claude-sonnet-5",  "effort": "medium"},
    "OPUS_MEDIUM": {"agent": "implement-medium",    "model": "claude-opus-5-5",  "effort": "medium"},
    "OPUS_HIGH":   {"agent": "implement-high",      "model": "claude-opus-5-5",  "effort": "high"},
    "FABLE_HIGH":  {"agent": "implement-escalated", "model": "claude-fable-5-1", "effort": "high"},
    "FABLE_XHIGH": {"agent": "implement-extreme",   "model": "claude-fable-5-1", "effort": "xhigh"},
    "LOOKUP":      {"agent": "lookup",              "model": "claude-haiku-4-5-20251001", "effort": null},
    "RESEARCH":    {"agent": "research",            "model": "claude-sonnet-5",  "effort": "medium"}
  },
  "ladder": ["SONNET_MEDIUM", "OPUS_MEDIUM", "OPUS_HIGH", "FABLE_HIGH", "FABLE_XHIGH"],
  "classes": {
    "SMALL":    {"lane": "SONNET_MEDIUM", "description": "Small, well-understood change: bounded scope (roughly one module), known pattern, obvious verification. Scaffolding, configuration, a CLI over existing code."},
    "MEDIUM":   {"lane": "OPUS_MEDIUM", "description": "Normal feature work: a few files, some design choices, standard tests."},
    "HIGH":     {"lane": "OPUS_HIGH",   "description": "Complex debugging, cross-cutting edits, concurrency and locking, data integrity and migrations, or security-sensitive behavior."},
    "ESCALATE": {"lane": "FABLE_HIGH",  "description": "Unresolved architecture, competing designs, or difficult failures that stronger models have not resolved."}
  },
  "security_sensitive_min_class": "HIGH",
  "limits": {
    "confidence_threshold": 0.80,
    "max_failed_cycles_per_lane": 2,
    "max_cycles_per_unit": 6
  },
  "jev": {
    "endpoint": "https://api.typesafe.ai/v1/systemone",
    "model": "jev-latest",
    "timeout_seconds": 10,
    "env_file": "~/.config/jev/.env"
  },
  "retention_hours": 24,
  "pricing": {
    "_note": "USD per million tokens, used only for estimates in router-report. Anthropic first-party API rates as of 2026-06-24; cache writes use the standard 1.25x (5m) / 2x (1h) input multipliers. Verify against current pricing and edit as needed.",
    "claude-opus-5-5":  {"input": 4.00,  "output": 20.00, "cache_write_5m": 5.00,  "cache_write_1h": 8.00,  "cache_read": 0.20},
    "claude-fable-5-1": {"input": 10.00, "output": 50.00, "cache_write_5m": 12.50, "cache_write_1h": 20.00, "cache_read": 0.25},
    "claude-sonnet-5":  {"input": 2.00,  "output": 10.00, "cache_write_5m": 2.50,  "cache_write_1h": 4.00,  "cache_read": 0.20},
    "claude-haiku-4-5": {"input": 1.00,  "output": 5.00,  "cache_write_5m": 1.25,  "cache_write_1h": 2.00,  "cache_read": 0.10},
    "claude-opus-5":    {"input": 5.00,  "output": 25.00, "cache_write_5m": 6.25,  "cache_write_1h": 10.00, "cache_read": 0.50},
    "claude-fable-5":   {"input": 10.00, "output": 50.00, "cache_write_5m": 12.50, "cache_write_1h": 20.00, "cache_read": 1.00}
  },
  "input_limits": {
    "max_text": 2000,
    "max_criteria": 20,
    "max_checks": 40,
    "max_request_bytes": 16384
  }
}
